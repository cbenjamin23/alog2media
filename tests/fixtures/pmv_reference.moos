ServerHost = localhost
ServerPort = 9000
Community  = shoreside

LatOrigin  = 42.0
LongOrigin = -71.0

ProcessConfig = pMarineViewer
{
  TIFF_FILE            = basic.tif
  set_pan_x            = 0
  set_pan_y            = 0
  zoom                 = 1
  hash_viewable        = false
  vehicles_name_mode   = names
  vehicles_shape_scale = 1
  trails_viewable      = false
}
